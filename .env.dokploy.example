# Copy to Dokploy environment variables (or a local .env file for testing).
# Generate secrets with: openssl rand -base64 48

DOMAIN=equilog.ry.beebase.cloud

# Application
ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=Equine.Api
JWT_AUDIENCE=EquineClient
JWT_SECURITY_KEY=change-me-to-at-least-32-random-characters

ADMIN_EMAIL=admin@equijournal.se
# Must be 12+ chars with uppercase, lowercase, digit, and symbol (Identity policy).
ADMIN_PASSWORD=ChangeMe-Admin-123!
ADMIN_DISPLAY_NAME=Admin

# PostgreSQL
# Changing POSTGRES_PASSWORD on an existing stack is handled: the postgres service
# re-applies it to the role on every start. Give it a minute and redeploy. If the API
# still reports SqlState 28P01, see docs/runbooks/postgres-auth-failure.md
# Use a distinct value -- do not reuse a slice of JWT_SECURITY_KEY or another secret.
POSTGRES_DB=equijournal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# Object storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
STORAGE_BUCKET=equine-attachments

# Email (Mailpit in this stack — no real delivery)
SMTP_FROM=bokning@equilog.ry.beebase.cloud
SMTP_FROM_NAME=HästJournal

# Practice defaults (seeded on first run)
PRACTITIONER_NAME=Victor
PRACTITIONER_CLINIC=HästJournal
PRACTITIONER_ADDRESS=Skåne, Sverige
PRACTITIONER_PHONE=0700000000
PRACTITIONER_EMAIL=admin@equijournal.se

# Optional
GOOGLE_MAPS_BROWSER_KEY=
NOTIFICATIONS_SENDING_DOMAIN=
