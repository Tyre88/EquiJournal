    "@angular/forms": "22.1.5",
    "@angular/localize": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/router": "20.3.30",
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.30",
