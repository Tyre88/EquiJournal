{
  "name": "equijournal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve:admin": "ng serve admin",
    "serve:widget": "ng serve widget",
    "serve:portal": "ng serve portal",
    "build": "ng build admin && ng build widget && ng build portal",
    "build:admin": "ng build admin",
    "build:widget": "ng build widget",
    "build:loader": "npm --prefix ../widget-loader run build && npm --prefix ../widget-loader run size",
